# ==============================================================================
# ZLALALAZ BACKEND - VARIABLES DE ENTORNO (PLANTILLA EJEMPLO)
# ==============================================================================

# Entorno y Puerto
NODE_ENV=development
PORT=3001

# Conexión a Base de Datos PostgreSQL
# Opción A: Motor local portable en ../pgsql/:
DB_TYPE=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=zlalalazdb

# Opción B: Conexión vía Supabase Postgres (Pooler y Directa)
DATABASE_URL="postgresql://postgres.cwyugyjgqpcmzwegjwsy:[TU-CONTRASENA]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.cwyugyjgqpcmzwegjwsy:[TU-CONTRASENA]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# Parámetros directos Supabase Postgres
SUPABASE_DB_HOST=db.cwyugyjgqpcmzwegjwsy.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres

# ------------------------------------------------------------------------------
# Supabase API y Autenticación
# ------------------------------------------------------------------------------
SUPABASE_URL=https://cwyugyjgqpcmzwegjwsy.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_tu_clave_publica_aqui
SUPABASE_SECRET_KEY=sb_secret_tu_clave_secreta_aqui
SUPABASE_JWKS_URL=https://cwyugyjgqpcmzwegjwsy.supabase.co/auth/v1/.well-known/jwks.json

NEXT_PUBLIC_SUPABASE_URL=https://cwyugyjgqpcmzwegjwsy.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_tu_clave_publica_aqui

# ------------------------------------------------------------------------------
# Autenticación JWT y CORS
# ------------------------------------------------------------------------------
# Obligatorio: generar con node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CAMBIAR_ESTE_VALOR_MINIMO_32_CARACTERES
JWT_EXPIRACION=12h

# Orígenes permitidos por CORS, entre comillas y separados por ";"
CORS_ORIGENES="http://localhost:3000";"http://127.0.0.1:3000"

ADMIN_EMAIL=admin@lalala.com
ADMIN_PASSWORD=Admin123*

VENDEDOR_EMAIL=ventas@lalala.com
VENDEDOR_PASSWORD=Ventas123*

# ------------------------------------------------------------------------------
# Almacenamiento de Fotos e Imágenes (Cloudflare R2 / S3 / Local)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=cloudflare_r2
# Opciones disponibles:
#   'local'         : Guarda en disco local (/uploads) y sirve vía HTTP local
#   'cloudflare_r2' : Almacenamiento Cloudflare R2 (10 GB gratis, 0$ egress)
#   'nube'          : Bucket compatible con Amazon S3 / R2 / MinIO

# --- Configuración Cloudflare R2 ---
R2_ENDPOINT=https://d251761c0dc1936ac1f154bd868c3e9c.us.r2.cloudflarestorage.com
R2_BUCKET_NAME=lalalabucket
R2_ACCESS_KEY_ID=tu_r2_access_key_id_aqui
R2_SECRET_ACCESS_KEY=tu_r2_secret_access_key_aqui
# R2_PUBLIC_DOMAIN=https://pub-calzado.r2.dev

# --- Variables S3 estándar (compatibilidad) ---
S3_ENDPOINT=https://d251761c0dc1936ac1f154bd868c3e9c.us.r2.cloudflarestorage.com
S3_BUCKET_NAME=lalalabucket
S3_REGION=auto
S3_ACCESS_KEY_ID=tu_r2_access_key_id_aqui
S3_SECRET_ACCESS_KEY=tu_r2_secret_access_key_aqui
