# ==============================================================================
# ZLALALAZ BACKEND - VARIABLES DE ENTORNO
# ==============================================================================

# Entorno y Puerto
NODE_ENV=development
PORT=3001

# Conexión a Base de Datos PostgreSQL
# Para local usando el motor portable copiado en ../pgsql/:
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=zlalalazdb

# En producción (Vercel / Supabase / Neon):
# DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/zlalalaz_calzado_db?sslmode=require

# Autenticación JWT
JWT_SECRET=zlalalaz_super_secret_jwt_key_2026_calzado_store_bolivia
JWT_EXPIRATION_TIME=30d

# ------------------------------------------------------------------------------
# ALMACENAMIENTO DE IMÁGENES - ESTRATEGIA "PRESUPUESTO CERO"
# Proveedor por defecto recomendado: Cloudflare R2 (10 GB gratis, 0$ Egress)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=cloudflare_r2
# Opciones disponibles: 'cloudflare_r2' | 'supabase' | 'local'

# Credenciales Cloudflare R2 (Compatibilidad AWS S3 API):
# Generar en: Cloudflare Dashboard -> R2 -> Manage R2 API Tokens -> Create API token
R2_ACCESS_KEY_ID=tu_access_key_id_aqui
R2_SECRET_ACCESS_KEY=tu_secret_access_key_aqui
R2_ENDPOINT=https://<tu_account_id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=zlalalaz-calzado
R2_PUBLIC_DOMAIN=https://pub-<hash>.r2.dev

# Fallback: Supabase Storage (1 GB gratis, 5 GB egress mensual)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui
SUPABASE_BUCKET_NAME=calzados
